{
  "name": "@lms/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, constants, and validators for LMS",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/write-dist-package-markers.js",
    "dev": "tsc -p tsconfig.cjs.json --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "@types/jest": "^30.0.0"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "NodeNext",
            "moduleResolution": "NodeNext",
            "isolatedModules": true
          }
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testEnvironment": "node"
  }
}
