// Laboratory Management System — Prisma Schema
// Source of truth: 03_Core_Domain_Design.md
// Every operationally-scoped table carries tenant_id (and branch_id when multi-branch is active).
// Fixed to a single tenant for this client's deployment.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// TENANCY & BRANCHES
// =============================================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  users    User[]
  patients Patient[]
  doctors  Doctor[]
  companies Company[]
  tests    Test[]
  packages Package[]
  bookings Booking[]
  invoices Invoice[]
  samples  Sample[]
  results  Result[]
  reports  Report[]
  notifications Notification[]
  cashShifts CashShift[]
  shares DoctorShare[]
  auditLogs AuditLog[]
  syncOutbox SyncOutbox[]
  featureFlags FeatureFlag[]
  configurations Configuration[]
  smsTemplates SmsTemplate[]
  visits Visit[]
  identifierCounters IdentifierCounter[]
  sessions AuthSession[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  users     User[]
  patients  Patient[]
  bookings  Booking[]
  invoices  Invoice[]
  samples   Sample[]
  reports   Report[]
  visits Visit[]
  identifierCounters IdentifierCounter[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

// =============================================================================
// AUTHENTICATION & AUTHORIZATION
// =============================================================================

enum Role {
  ADMIN
  RECEPTION
  SAMPLE_COLLECTOR
  LAB_TECH
  LAB_OPERATOR // Combined role for this v1 client (Reception + Sample Collector + Lab Tech)
  CASHIER
  PATHOLOGIST
  ACCOUNTANT
  DOCTOR_PORTAL
  CORPORATE_MANAGER
  WEBSITE_CONTENT_MANAGER
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  branchId     String?
  email        String?
  username     String
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  auditLogs AuditLog[] @relation("AuditActor")
  cashShiftsOpened CashShift[] @relation("CashShiftOpenedBy")
  cashShiftsClosed CashShift[] @relation("CashShiftClosedBy")
  sampleEvents SampleEvent[]
  resultCorrections Result[] @relation("ResultCorrectionActor")
  reportReleases ReportVersion[]
  recordedPayments Payment[]
  invoiceAdjustments InvoiceAdjustment[]
  sessions AuthSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@index([tenantId])
  @@map("users")
}

// =============================================================================
// PATIENT MANAGEMENT
// =============================================================================

model AuthSession {
  id String @id @default(cuid())
  tokenHash String @unique
  tenantId String
  userId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  revocationReason String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  @@index([tenantId, userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model LoginAttempt {
  attemptKey String @id
  failures Int @default(0)
  windowStartedAt DateTime @default(now()) @db.Timestamptz(3)
  lockedUntil DateTime? @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([updatedAt])
  @@map("login_attempts")
}

model Patient {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String?   // Preferential home branch (optional)
  mrn         String?   // Medical Record Number (legacy/optional, unused by UI)
  labNumber   String    // Permanent internal lab ID, e.g. LAB-000123 (visible in-app; never printed)
  mrcNumber   String    // External outsourcing reference, e.g. MRC-000123 (visible in-app; never printed)
  fullName    String
  phone       String
  phoneAlt    String?
  cnic        String?   // Pakistani CNIC
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  email       String?
  bloodGroup  String?
  notes       String?
  smsConsent  Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  bookings Booking[]
  companyLinks PatientCompany[]
  visits Visit[]
  notifications Notification[]

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@unique([tenantId, labNumber])
  @@unique([tenantId, mrcNumber])
  @@index([tenantId, cnic])
  @@index([tenantId, fullName])
  @@index([tenantId, labNumber])
  @@index([tenantId, mrcNumber])
  @@index([tenantId])
  @@map("patients")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

// =============================================================================
// DOCTOR MANAGEMENT
// =============================================================================

model Doctor {
  id              String   @id @default(cuid())
  tenantId        String
  fullName        String
  phone           String?
  email           String?
  specialty       String?
  clinicName      String?
  shareType       ShareType @default(PERCENTAGE)
  shareValue      Decimal  @db.Decimal(10, 2) // % or fixed amount
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  bookings    Booking[]
  shares DoctorShare[]
  visits Visit[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("doctors")
}

enum ShareType {
  PERCENTAGE
  FIXED_AMOUNT
  PER_TEST_FIXED
}

// =============================================================================
// CORPORATE ACCOUNTS
// =============================================================================

model Company {
  id                    String   @id @default(cuid())
  tenantId              String
  name                  String
  code                  String?
  contactPerson         String?
  phone                 String?
  email                 String?
  address               String?
  billingMode           CorporateBillingMode @default(COMPANY_PAYS_ALL)
  resultSharingPolicy   ResultSharingPolicy  @default(BILLING_ONLY)
  discountPercent       Decimal? @db.Decimal(5, 2)
  isActive              Boolean  @default(true)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  patients PatientCompany[]
  invoices Invoice[]
  visits Visit[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("companies")
}

enum CorporateBillingMode {
  COMPANY_PAYS_ALL
  SPLIT_COPAY
  EMPLOYEE_PAYS
}

enum ResultSharingPolicy {
  BILLING_ONLY
  FULL_REPORTS
}

model PatientCompany {
  id        String   @id @default(cuid())
  patientId String
  companyId String
  employeeId String? // Employee number at the company
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([patientId, companyId])
  @@map("patient_companies")
}

// =============================================================================
// TEST CATALOG & PACKAGES
// =============================================================================

enum ParameterValueType {
  NUMERIC
  TEXT
  BOOLEAN
  CHOICE // value must be one of TestParameterChoice options
}

model Test {
  id              String   @id @default(cuid())
  tenantId        String
  code            String
  name            String
  category        String?
  sampleType      String?  // e.g. Blood, Urine, Serum
  basePrice       Decimal  @db.Decimal(12, 2)
  turnaroundHours Int?
  isActive        Boolean  @default(true)
  description     String?
  /// true = multi-parameter panel (e.g. CBC); false = single-value test
  isPanel         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  parameters      TestParameter[]
  packageItems    PackageItem[]
  invoiceLines    InvoiceLine[]
  results         Result[]
  versions        TestVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tests")
}

/// A single measurable variable belonging to a Test.
/// Single-value tests have exactly one parameter; panels (CBC etc.) have many.
model TestParameter {
  id              String             @id @default(cuid())
  testId          String
  testVersionId   String? // Initial capture link; frozen snapshot is authoritative while editor stays legacy.
  code            String             // e.g. WBC, RBC, HGB
  name            String             // e.g. White Blood Cells
  valueType       ParameterValueType @default(NUMERIC)
  unit            String?            // default display unit
  sortOrder       Int                @default(0)
  isRequired      Boolean            @default(true)
  decimalPlaces   Int?               // for NUMERIC display/rounding
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  test            Test                   @relation(fields: [testId], references: [id], onDelete: Cascade)
  testVersion     TestVersion? @relation(fields: [testId, testVersionId], references: [testId, id], onDelete: Restrict, onUpdate: Restrict)
  referenceRanges TestReferenceRange[]
  choices         TestParameterChoice[]
  resultValues    ResultValue[]

  @@unique([testId, code])
  @@index([testId])
  @@index([testId, testVersionId])
  @@map("test_parameters")
}

/// Optional fixed choices for CHOICE-type parameters (e.g. Positive/Negative)
model TestParameterChoice {
  id              String @id @default(cuid())
  testParameterId String
  value           String
  label           String
  sortOrder       Int    @default(0)

  parameter TestParameter @relation(fields: [testParameterId], references: [id], onDelete: Cascade)

  @@unique([testParameterId, value])
  @@index([testParameterId])
  @@map("test_parameter_choices")
}

/// Reference / critical ranges — attached to a parameter (not the whole test)
model TestReferenceRange {
  id              String   @id @default(cuid())
  testParameterId String
  gender          Gender?  // null = all
  ageMinMonths    Int?     // null = no lower bound
  ageMaxMonths    Int?     // null = no upper bound
  lowNormal       Decimal? @db.Decimal(12, 4)
  highNormal      Decimal? @db.Decimal(12, 4)
  criticalLow     Decimal? @db.Decimal(12, 4)
  criticalHigh    Decimal? @db.Decimal(12, 4)
  unit            String?  // overrides parameter unit if set
  interpretation  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parameter TestParameter @relation(fields: [testParameterId], references: [id], onDelete: Cascade)

  @@index([testParameterId])
  @@map("test_reference_ranges")
}

model Package {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  basePrice   Decimal  @db.Decimal(12, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  items        PackageItem[]
  invoiceLines InvoiceLine[]
  versions PackageVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("packages")
}

model PackageItem {
  id              String  @id @default(cuid())
  packageId       String
  testId          String?
  nestedPackageId String? // Support nested packages
  sortOrder       Int     @default(0)
  packageVersionId String?
  testVersionId String?

  package       Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  test          Test?    @relation(fields: [testId], references: [id])
  packageVersion PackageVersion? @relation(fields: [packageId, packageVersionId], references: [packageId, id], onDelete: Restrict, onUpdate: Restrict)
  testVersion TestVersion? @relation(fields: [testId, testVersionId], references: [testId, id], onDelete: Restrict, onUpdate: Restrict)
  // nestedPackage relation omitted for simplicity; handled in application layer

  @@index([packageId])
  @@index([packageId, packageVersionId])
  @@index([testId, testVersionId])
  @@map("package_items")
}

// =============================================================================
// BOOKING
// =============================================================================

enum BookingStatus {
  PENDING_REVIEW  // Online booking awaiting staff
  CONFIRMED
  CHECKED_IN
  CONVERTED       // Invoice generated
  EXPIRED
  CANCELLED
}

enum BookingSource {
  WALK_IN
  ONLINE
  HOME_COLLECTION
  PHONE
}

model Booking {
  id                String        @id @default(cuid())
  tenantId          String
  branchId          String
  patientId         String
  doctorId          String?       // Referring doctor
  companyId         String?
  status            BookingStatus @default(CONFIRMED)
  source            BookingSource @default(WALK_IN)
  bookingCode       String        // Human-readable / SMS code
  preferredAt       DateTime?     // Requested slot
  checkedInAt       DateTime?
  notes             String?
  // Home collection fields
  homeAddress       String?
  homeCollectorId   String?       // User id of collector
  homeRouteNotes    String?
  homeTimeWindowStart DateTime?
  homeTimeWindowEnd   DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor? @relation(fields: [doctorId], references: [id])
  invoice Invoice?
  visit Visit?

  @@unique([tenantId, branchId, patientId, id])
  @@unique([tenantId, bookingCode])
  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@index([branchId])
  @@map("bookings")
}

// =============================================================================
// BILLING — INVOICE & PAYMENT
// =============================================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOIDED
  CLOSED
  REFUNDED
}

model Invoice {
  id              String        @id @default(cuid())
  tenantId        String
  branchId        String
  bookingId       String        @unique
  visitId         String?       @unique
  phaseAReviewReason String?
  companyId       String?
  status          InvoiceStatus @default(DRAFT)
  invoiceNumber   String
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @db.Decimal(12, 2) @default(0)
  discountMode String @default("PER_LINE")
  invoiceDiscountAmount Decimal @db.Decimal(12, 2) @default(0)
  invoiceDiscountReason String?
  taxTotal        Decimal       @db.Decimal(12, 2) @default(0)
  grandTotal      Decimal       @db.Decimal(12, 2)
  amountPaid      Decimal       @db.Decimal(12, 2) @default(0)
  amountDue       Decimal       @db.Decimal(12, 2)
  currency        String        @default("PKR")
  notes           String?
  issuedAt        DateTime?
  closedAt        DateTime?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  branch   Branch        @relation(fields: [branchId], references: [id])
  booking  Booking       @relation(fields: [bookingId], references: [id])
  company  Company?      @relation(fields: [companyId], references: [id])
  lines    InvoiceLine[]
  payments Payment[]
  adjustments InvoiceAdjustment[]
  samples  Sample[]
  report   Report?
  shares DoctorShare[]
  visit Visit? @relation(fields: [tenantId, branchId, visitId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, branchId, visitId])
  @@unique([tenantId, id])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([branchId])
  @@map("invoices")
}

model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  phaseAReviewReason String?
  testId          String?
  packageId       String?
  description     String
  quantity        Int      @default(1)
  unitPrice       Decimal  @db.Decimal(12, 2) // Snapshotted final unit price after pipeline
  basePrice       Decimal  @db.Decimal(12, 2) // Original catalog price
  discountAmount  Decimal  @db.Decimal(12, 2) @default(0)
  taxAmount       Decimal  @db.Decimal(12, 2) @default(0)
  lineTotal       Decimal  @db.Decimal(12, 2)
  sortOrder       Int      @default(0)
  // Pricing pipeline audit
  doctorDiscount  Decimal? @db.Decimal(12, 2)
  corporateDiscount Decimal? @db.Decimal(12, 2)
  campaignDiscount Decimal? @db.Decimal(12, 2)
  manualDiscount  Decimal? @db.Decimal(12, 2)
  manualDiscountReason String?
  createdAt       DateTime @default(now())

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  test    Test?    @relation(fields: [testId], references: [id])
  package Package? @relation(fields: [packageId], references: [id])
  results Result[]
  orderedTests OrderedTest[]

  @@index([invoiceId])
  @@map("invoice_lines")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  EASYPAISA
  JAZZCASH
  CARD          // Disabled in v1 but interface-ready
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  VOIDED
  REFUNDED
  FAILED
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?       // Transaction ID / cheque number
  receivedAt    DateTime?
  refundedAt    DateTime?
  refundReason  String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenantId      String?       // Legacy movements retain unknown metadata.
  recordedById  String?
  operationKey  String?
  requestHash   String?
  postedAt      DateTime?     @db.Timestamptz(3)
  cashShiftId   String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User? @relation(fields: [tenantId, recordedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  adjustments InvoiceAdjustment[]
  cashShift CashShift? @relation(fields: [cashShiftId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, operationKey])
  @@unique([invoiceId, id])
  @@index([recordedById, postedAt])
  @@index([cashShiftId])
  @@index([invoiceId])
  @@map("payments")
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

/**
 * A cashier's working session for reconciling physical cash against what
 * the system recorded. Scoped to CASH-method payments only (the whole
 * point is counting money in a drawer — card/bank/wallet payments never
 * touch a drawer, so they're excluded from expectedCash entirely; see
 * cash-shifts.service.ts).
 *
 * Phase C attributes new cash by branch, cashier and posting-time shift.
 * Legacy unknown actors stay unassigned; closed historical snapshots are retained.
 */
model CashShift {
  id           String          @id @default(cuid())
  tenantId     String
  branchId     String?
  openedById   String
  openedAt     DateTime        @default(now())
  closedById   String?
  closedAt     DateTime?
  expectedCash Decimal?        @db.Decimal(12, 2) // Snapshotted at close time, not live-recomputed after
  countedCash  Decimal?        @db.Decimal(12, 2) // What the cashier physically counted
  variance     Decimal?        @db.Decimal(12, 2) // countedCash - expectedCash; negative = short, positive = over
  notes        String?
  status       CashShiftStatus @default(OPEN)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  openedBy User   @relation("CashShiftOpenedBy", fields: [openedById], references: [id])
  closedBy User?  @relation("CashShiftClosedBy", fields: [closedById], references: [id])
  payments Payment[]
  adjustments InvoiceAdjustment[]

  @@index([tenantId, status])
  @@map("cash_shifts")
}

// =============================================================================
// LABORATORY — SAMPLE, RESULT, REPORT
// =============================================================================

enum SampleStatus {
  PENDING_COLLECTION
  COLLECTED
  IN_TRANSIT
  RECEIVED_AT_LAB
  ACCEPTED
  REJECTED
  RECOLLECTED
  IN_TESTING
  COMPLETED
  DISCARDED
}

model Sample {
  id              String       @id @default(cuid())
  tenantId        String
  branchId        String
  invoiceId       String
  visitId         String?
  previousSampleId String?
  phaseAReviewReason String?
  sampleCode      String       // Barcode / label code
  status          SampleStatus @default(PENDING_COLLECTION)
  sampleType      String?
  collectedAt     DateTime?
  collectedById   String?      // User id
  receivedAt      DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  discardedAt     DateTime?
  notes           String?
  isOutsourced      Boolean  @default(false)
  externalLabName   String?
  outsourcingCost   Decimal? @db.Decimal(10, 2) // What we pay the external lab
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  branch  Branch   @relation(fields: [branchId], references: [id])
  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  results Result[]
  visit Visit? @relation(fields: [tenantId, branchId, visitId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  previousSample Sample? @relation("SampleReplacement", fields: [tenantId, branchId, visitId, previousSampleId], references: [tenantId, branchId, visitId, id], onDelete: Restrict, onUpdate: Restrict)
  replacements Sample[] @relation("SampleReplacement")
  assignments SampleTest[]
  events SampleEvent[]

  @@unique([tenantId, branchId, visitId, id])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, visitId])
  @@index([tenantId, branchId, visitId, previousSampleId])
  @@unique([tenantId, sampleCode])
  @@index([tenantId, status])
  @@index([tenantId, isOutsourced])
  @@index([invoiceId])
  @@map("samples")
}

enum ResultStatus {
  ENTERED
  RELEASED
  SUPERSEDED
  VOIDED
}

/// One Result = one Test performed on one Sample (versioned header).
/// Actual measured values live in ResultValue (one row per TestParameter).
model Result {
  id                  String       @id @default(cuid())
  tenantId            String
  sampleId            String
  invoiceLineId       String
  testId              String
  orderedTestId       String?
  testVersionId       String?
  revisionNo          Int?
  amendmentReason     String?
  amendmentActorId    String?
  status              ResultStatus @default(ENTERED)
  /// True if any of its ResultValues is critical
  isCritical          Boolean      @default(false)
  enteredById         String?
  enteredAt           DateTime     @default(now())
  releasedById        String?
  releasedAt          DateTime?
  amendedFromResultId String?      // Points to previous version
  voidReason          String?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  sample      Sample        @relation(fields: [sampleId], references: [id])
  invoiceLine InvoiceLine   @relation(fields: [invoiceLineId], references: [id])
  test        Test          @relation(fields: [testId], references: [id])
  values      ResultValue[]
  clinicalValues ResultValue[] @relation("ClinicalResultValues")
  amendedFrom Result?       @relation("ResultAmendments", fields: [amendedFromResultId], references: [id])
  amendments  Result[]      @relation("ResultAmendments")
  reportMemberships ReportVersionResult[]
  orderedTest OrderedTest? @relation(fields: [tenantId, orderedTestId, testVersionId], references: [tenantId, id, testVersionId], onDelete: Restrict, onUpdate: Restrict)
  assignment SampleTest? @relation(fields: [sampleId, orderedTestId], references: [sampleId, orderedTestId], onDelete: Restrict, onUpdate: Restrict)
  amendmentActor User? @relation("ResultCorrectionActor", fields: [tenantId, amendmentActorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([orderedTestId, revisionNo])
  @@unique([id, testVersionId])
  @@unique([id, orderedTestId])

  @@index([tenantId])
