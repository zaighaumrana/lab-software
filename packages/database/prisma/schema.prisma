  // Historical timezone/clinical-time evidence is insufficient: retain raw text, leave instant NULL.
  occurredAt DateTime? @db.Timestamptz(3)
  legacyOccurredAtRaw String?
  patientNameSnapshot String
  labNumberSnapshot String
  mrcNumberSnapshot String
  // Current master capture, not a claim about demographics at a historical sale.
  demographicCaptureProvenance CaptureProvenance @map("demographicSource")
  doctorNameSnapshot String?
  companyNameSnapshot String?
  reviewReason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  rowVersion Int @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
