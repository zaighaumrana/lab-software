  id String @id @default(dbgenerated("(gen_random_uuid())::text"))
  versionParameterId String
  legacyRangeId String
  gender Gender?
  ageMinMonths Int?
  ageMaxMonths Int?
  lowNormal Decimal? @db.Decimal(12, 4)
  highNormal Decimal? @db.Decimal(12, 4)
  criticalLow Decimal? @db.Decimal(12, 4)
  criticalHigh Decimal? @db.Decimal(12, 4)
  unit String?
  interpretation String?
  parameter TestVersionParameter @relation(fields: [versionParameterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resultValues ResultValue[]
  @@unique([versionParameterId, id])
  @@unique([versionParameterId, legacyRangeId])
  @@map("test_version_reference_ranges")
}
