# Migration/database owner tooling only. Supply the installation's connection privately.
DATABASE_URL=""
# The hardened API instead loads its separate apps/api/.env.runtime file.
# Provision it with scripts/provision-runtime-db.ps1; see apps/api/.env.example.
# Optional installation/admin connection for role provisioning only; never API runtime.
PROVISION_DATABASE_URL=""
# Explicit local development compatibility: DB_RUNTIME_MODE="development" permits
# DATABASE_URL fallback only outside NODE_ENV=production. This is not hardened deployment.

# SendPK credentials remain server-side. Tenant master/event settings contain no secrets.
SENDPK_API_KEY=""
SENDPK_SENDER=""
