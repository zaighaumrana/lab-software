{
  "name": "@lms/database",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma schema, client, and migrations for the Laboratory Management System",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate && pnpm build",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "push": "prisma db push",
    "seed": "pnpm build && tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "build": "tsc",
    "test": "pnpm build && tsx --test test/client.test.ts",
    "test:integration": "pnpm build && tsx test/run-integration.ts",
    "test:b1": "pnpm build && tsx test/run-integration.ts b1",
    "test:b2": "pnpm build && tsx test/run-integration.ts b2",
    "test:sms": "pnpm build && tsx test/run-integration.ts sms",
    "test:e1": "pnpm build && node test/run-e1.cjs",
    "test:e2": "pnpm build && node test/run-e2.cjs",
    "test:f1": "pnpm build && node test/run-f1.cjs",
    "test:d2": "pnpm build && tsx test/run-integration.ts d2",
    "test:d1": "pnpm build && tsx test/run-integration.ts d1",
    "test:c": "pnpm build && tsx test/run-integration.ts c",
    "test:phase-a": "pnpm build && tsx test/run-phase-a.ts",
    "validate": "prisma validate",
    "migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "bcrypt": "^6.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
